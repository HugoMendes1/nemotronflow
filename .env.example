# NemotronFlow requires no environment variables in v1.
# This file documents any future configuration knobs as they are introduced.
#
# Optional overrides (none required for normal use):
# NEMOTRONFLOW_DATA_DIR=<path>   # redirect ~/.nemotronflow to another location
# NEMOTRONFLOW_LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR | CRITICAL
# NEMOTRONFLOW_PORT=0            # 0 = OS-assigned ephemeral (default)
